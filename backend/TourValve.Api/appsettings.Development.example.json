{
  "App": {
    "PublicBaseUrl": "http://localhost:3000",
    "DisplayName": "FlyViaSS"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=tourvalve_db;Username=postgres;Password=your-password"
  },
  "Jwt": {
    "Key": "replace-with-a-long-random-development-secret",
    "Issuer": "tourvalve.local",
    "Audience": "tourvalve.local",
    "ExpireMinutes": 120
  },
  "WalletAlerts": {
    "LowBalanceThreshold": 500,
    "CriticalBalanceThreshold": 100
  },
  "AirTicketing": {
    "AutoIssueEnabled": false
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseSsl": true,
    "Username": "tourvalve@gmail.com",
    "Password": "",
    "FromEmail": "tourvalve@gmail.com",
    "FromName": "",
    "AdminInboxEmail": "tourvalve@gmail.com"
  },
  "Atlas": {
    "Enabled": false,
    "BaseUrl": "https://sandbox.atriptech.com",
    "ClientId": "your-atlas-client-id",
    "ClientSecret": "your-atlas-client-secret",
    "ResidentCode": "",
    "Currency": "MYR",
    "RequestSource": "TourValve",
    "DefaultNationality": "MY",
    "DefaultCardIssuePlace": "MY",
    "UseAtlasMailForContact": true
  },
  "Travelport": {
    "MockMode": false,
    "SystemEndpoint": "https://apac.universal-api.pp.travelport.com/B2BGateway/connect/uAPI/SystemService",
    "AirEndpoint": "https://apac.universal-api.pp.travelport.com/B2BGateway/connect/uAPI/AirService",
    "UniversalEndpoint": "https://apac.universal-api.pp.travelport.com/B2BGateway/connect/uAPI/UniversalRecordService",
    "TerminalEndpoint": "https://apac.universal-api.pp.travelport.com/B2BGateway/connect/uAPI/TerminalService",
    "TargetBranch": "your-target-branch",
    "Username": "Universal API/your-username",
    "Password": "your-password"
  }
}